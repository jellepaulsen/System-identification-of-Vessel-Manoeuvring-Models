import numpy as np
import pandas as pd

def create_test_data(
    duration_s: float,
    rpm: float,
    rudder_angle: float,
    fs: float = 100.0
) -> pd.DataFrame:
    """
    Erzeugt synthetische Testdaten für ein System mit konstanter Drehzahl
    und konstantem Ruderwinkel.

    Parameters
    ----------
    duration_s : float
        Versuchsdauer in Sekunden
    rpm : float
        konstante Drehzahl
    rudder_angle : float
        konstanter Ruderwinkel
    fs : float
        Samplingrate (Hz), default 10 Hz

    Returns
    -------
    pd.DataFrame
        Index: time [s]
        Columns: N0, N1, delta0, delta1
    """

    dt = 1.0 / fs
    t = np.arange(0, duration_s + dt, dt)

    # einfache, konsistente Systemabbildung (placeholder Modell)
    # N = Funktion aus rpm + rudder coupling
    N = rpm 

    # delta = konstante Eingangsgröße + leichte skalierte Kopplung
    delta = rudder_angle/180 * np.pi * np.ones_like(t)

    df = pd.DataFrame({
        "N0": N,
        "N1": N,
        "delta_r0": delta,
        "delta_r1": delta
    }, index=t)

    df.index.name = "ts"

    return df


def create_zigzag_test_data(
    h: float,
    h0: float,
    n: int,
    N: float,
    delta: float,
    rate_of_turn: float,
    fs: float = 100.0,
) -> pd.DataFrame:
    """
    Erzeugt synthetische Zigzag-Testdaten mit gleicher Drehzahl und gleichem
    Ruderwinkel fuer beide Antriebe.

    Parameters
    ----------
    h : float
        Haltezeit je Ruderlage in Sekunden
    h0 : float
        Initialisierungszeit in Sekunden mit delta = 0
    n : int
        Anzahl der Ruderalternationen
    N : float
        Konstante Drehzahl fuer beide Propeller
    delta : float
        Ruderwinkel in Grad, alternierend zwischen +delta und -delta
    rate_of_turn : float
        Maximale Ruderaenderung in Grad pro Sekunde
    fs : float
        Samplingrate (Hz), default 100 Hz

    Returns
    -------
    pd.DataFrame
        Index: time [s]
        Columns: N0, N1, delta_r0, delta_r1
    """
    if h <= 0:
        raise ValueError("h must be > 0")
    if h0 < 0:
        raise ValueError("h0 must be >= 0")
    if n <= 0:
        raise ValueError("n must be > 0")
    if rate_of_turn <= 0:
        raise ValueError("rate_of_turn must be > 0")
    if fs <= 0:
        raise ValueError("fs must be > 0")

    dt = 1.0 / fs
    total_duration = h0 + n * h
    t = np.arange(0, total_duration + dt, dt)

    delta_rad = np.radians(delta)
    rate_of_turn_rad = np.radians(rate_of_turn)
    delta_cmd = np.zeros_like(t)
    delta_series = np.zeros_like(t)

    active_mask = t >= h0
    leg_index = np.floor((t[active_mask] - h0) / h).astype(int)
    leg_index = np.clip(leg_index, 0, n - 1)
    signs = np.where(leg_index % 2 == 0, 1.0, -1.0)
    delta_cmd[active_mask] = signs * delta_rad

    max_delta_step = rate_of_turn_rad * dt
    for i in range(1, len(t)):
        delta_error = delta_cmd[i] - delta_series[i - 1]
        delta_step = np.clip(delta_error, -max_delta_step, max_delta_step)
        delta_series[i] = delta_series[i - 1] + delta_step

    df = pd.DataFrame(
        {
            "N0": N,
            "N1": N,
            "delta_r0": delta_series,
            "delta_r1": delta_series,
        },
        index=t,
    )

    df.index.name = "ts"

    return df

if __name__ == "__main__":
    # Beispiel für die Erstellung von Testdaten
    # test_data = create_test_data(duration_s=300, rpm=550, rudder_angle=40)
    test_data = create_zigzag_test_data(h=25, h0=20, n=5, N=500, delta=20, rate_of_turn=2, fs=100)
    test_data.to_csv("data/01_raw/wlfa/test_data.csv")
